# Secrets and machine-local endpoints only.
#
# Everything that describes an experiment -- models, depths, meta budgets,
# dataset revisions, paths -- lives in the Hydra config tree under
# src/polyreflexion/conf/, so that a run is reproducible from its config alone.
# Override any of it on the command line:
#
#   polyrx-bench experiment=gpqa backends.nano.model=gpt-4o-mini

# Required unless running with experiment.use_stub=true
OPENAI_API_KEY=

# Optional: access the gated official GPQA release on Hugging Face.
# Without it the loader falls back to the public mirror.
# HF_TOKEN=

# Optional: only needed when pointing a role at an OpenAI-compatible gateway
# in front of Ollama (see conf/backends/local.yaml).
# OLLAMA_API_KEY=ollama
