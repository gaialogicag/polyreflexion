# Datasets are downloaded, never vendored. GPQA is gated and license-restricted.
# data/MANIFEST.json is the exception: it records what was downloaded.
data/*
!data/MANIFEST.json

# Run outputs are not tracked in this repository. Published results live
# wherever the paper does; this repo ships the method and the means to
# reproduce it.
results/
dist/

